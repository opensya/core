{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".nuxt/**", ".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    
    "lint": {
      "dependsOn": ["^lint"]
    },

    "format": {
      "cache": false,
      "persistent": true,
    },

    // "//#quality": {
    //   "dependsOn": ["//#lint", "//#format"]
    // },
    // "//#lint": {},
    // "//#format": {},
    
  }
}
