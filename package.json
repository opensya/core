{
  "name": "@opensya/core",
  "private": false,
  "version": "0.28.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "install:deps": "dotenv -e .env -- pnpm install",
    "i:deps": "dotenv -e .env -- pnpm install",
    "rmv": "tsx ./core/rm.ts",
    "clean": "rm -rf dist",
    "build:lib": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias",
    "dev": "tsx ./core/dev",
    "build": "pnpm build:lib && tsx ./dist/core/build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "vitest typecheck"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@nuxt/schema": "^4.4.5",
    "@opensya/config": "^0.30.0",
    "@opensya/share": "^0.28.10",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.1.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^5.0.0",
    "consola": "^3.4.2",
    "dayjs": "^1.11.20",
    "i18next": "^26.2.0",
    "i18next-fs-backend": "^2.6.5",
    "i18next-http-middleware": "^3.9.6",
    "lodash": "^4.18.1",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "ofetch": "^1.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.33",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.19",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
