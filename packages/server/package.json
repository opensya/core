    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@core/utils": "workspace:*",
    "consola": "^3.4.2",
    "fastify": "^5.8.5",
    "pkg-types": "^2.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@core/eslint": "workspace:*",
    "@core/tsconfig": "workspace:*",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
