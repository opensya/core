{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "rootDir": "./src",
    "outDir": "./dist",

    "paths": {
      "@core/*": ["./src/*"]
    },

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,

    "skipLibCheck": true,
    "strict": true,

    "allowJs": true,
    "checkJs": false,

    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "types": ["node", "vite/client"]
  },
  "include": ["./src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*"]
}
