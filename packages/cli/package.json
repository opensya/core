{
  "name": "@core/cli",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev0": "tsx .opensya/server.js --dev",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@core/utils": "workspace:*",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/react": "^1.1.7",
    "@fastify/vite": "^9.1.0",
    "@unhead/react": "^2.1.13",
    "@vitejs/plugin-react": "^6.0.2",
    "fastify": "^5.8.5",
    "history": "^5.3.0",
    "magicast": "^0.5.3",
    "minipass": "^7.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "react-router-dom": "^7.18.0",
    "reflect-metadata": "^0.2.2",
    "valtio": "^2.3.2",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@core/eslint": "workspace:*",
    "@core/tsconfig": "workspace:*",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
